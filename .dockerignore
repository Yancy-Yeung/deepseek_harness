# version control (we ship source, not history)
.git/
.github/workflows/*.yml        # we only need the docker workflow; others are heavy and rarely change

# IDE / editor noise — never needed in Docker build context
.vscode/
.idea/
*.swp
.DS_Store

# docs & website assets (huge, not used at runtime)
docs/cookbook/i18n/*.yaml       # bilingual doc files only add ~5MB to the context tarball
website/build*                   # pre-built VitePress site is rarely needed inside Docker image
*.i18n.yaml                      # skip all i18n copies unless explicitly required

# top-level node_modules — workspaces have their own; exclude root only.
node_modules/

# large generated artifacts that rebuild cheaply in the container (already excluded by .gitignore)
apps/cli/node_modules/           # each workspace has its own nm; Docker builds fresh via pnpm install inside image
apps/web/node_modules/
